#!/usr/bin/env bash
# Removes AI attribution lines from every commit message.
# Activate once per clone:  git config core.hooksPath .githooks

msg_file="$1"
tmp_file="${msg_file}.tmp"

grep -v -i -E '^(co-authored-by:.*(claude|anthropic)|.*generated with \[?claude code\]?)' "$msg_file" > "$tmp_file"

# Remove trailing blank lines left behind
sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$tmp_file" > "$msg_file"
rm -f "$tmp_file"

exit 0
